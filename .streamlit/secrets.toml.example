# Streamlit Cloud Secrets Template
# Copy these values to your Streamlit Cloud app settings:
# App Dashboard > Settings > Secrets

# Dentrix API Credentials
DENTRIX_CLIENT_ID = "your_client_id_here"
DENTRIX_CLIENT_SECRET = "your_client_secret_here"
DENTRIX_ORG_ID = "your_org_id_here"

# Supabase Credentials
SUPABASE_URL = "https://your-project.supabase.co"
SUPABASE_KEY = "your_supabase_anon_key_here"
